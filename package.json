{
  "name": "darshana-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "npm run content:chunks -- --if-missing",
    "build": "tsc --noEmit && npm run content:chunks && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.v2.json",
    "test": "vitest run",
    "content:validate": "esbuild scripts/validate-content.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/darsana-validate.mjs --log-level=error && node node_modules/.cache/darsana-validate.mjs",
    "content:report": "esbuild scripts/content-report.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/darsana-report.mjs --log-level=error && node node_modules/.cache/darsana-report.mjs",
    "content:index": "esbuild scripts/build-search-index.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/darsana-index.mjs --log-level=error && node node_modules/.cache/darsana-index.mjs",
    "content:chunks": "esbuild scripts/build-content-chunks.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/darsana-chunks.mjs --log-level=error && node node_modules/.cache/darsana-chunks.mjs",
    "content:audit": "esbuild scripts/evidence-audit.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/darsana-audit.mjs --log-level=error && node node_modules/.cache/darsana-audit.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.5.0",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^5.0.0"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.3"
  }
}
